---
import { site, cta, navegacion } from '../config/site';
import logoEmigrahoy from '../assets/logo-emigra-hoy.svg';
---

<header class="cabecera" data-cabecera>
  <div class="cabecera-fondo" aria-hidden="true"></div>
  <div class="wrap cabecera-fila">
    <a href="#inicio" class="marca" aria-label="EmigraHoy, ir al inicio">
      <img src={logoEmigrahoy.src} alt="Logo EmigraHoy" width="915" height="871" class="marca-logo" />
    </a>

    <nav aria-label="Principal" class="nav-escritorio">
      <ul>
        {
          navegacion.map((n) => (
            <li>
              <a href={n.href} data-nav-enlace={n.id} class="nav-enlace">
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="cabecera-acciones">
      <a href={site.whatsapp.href} class="nav-whatsapp" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"
          ><path
            fill="currentColor"
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91A9.85 9.85 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.16.04-.3-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48a.92.92 0 0 0-.67.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.16 1.75 2.67 4.24 3.75 1.58.68 2.2.74 2.99.62.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"
          ></path></svg
        >
        <span>WhatsApp</span>
      </a>
      <a href={cta.href} class="btn btn-sello cabecera-cta">{cta.texto}</a>
      <button
        type="button"
        class="menu-boton"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-boton
      >
        <span class="menu-boton-texto" data-menu-texto>Menú</span>
        <span class="menu-boton-rayas" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="menu-movil" data-menu hidden>
    <nav aria-label="Menú del celular" class="wrap menu-movil-nav">
      <ol>
        {
          navegacion.map((n, i) => (
            <li data-menu-item>
              <a href={n.href} class="menu-movil-enlace" data-menu-cierra>
                <span class="menu-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {n.texto}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="menu-movil-pie" data-menu-item>
        <a href={cta.href} class="btn btn-sello" data-menu-cierra>{cta.texto}</a>
        <a href={site.whatsapp.href} class="btn btn-linea" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
        <p>{site.whatsapp.visible} · {site.sede}</p>
      </div>
    </nav>
  </div>
</header>

<style>
  .cabecera {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
  }
  .cabecera-fondo {
    position: absolute;
    inset: 0;
    background: var(--color-papel);
    box-shadow: 0 1px 0 var(--color-linea);
    opacity: 0;
    transition: opacity 250ms var(--ease-salida);
  }
  .cabecera.compacta .cabecera-fondo,
  .cabecera.menu-abierto .cabecera-fondo {
    opacity: 1;
  }
  .cabecera-fila {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    border-radius: var(--r-control);
  }
  .marca-logo {
    height: 54px;
    width: auto;
    transform-origin: left center;
    transition: transform 250ms var(--ease-salida);
  }
  .cabecera.compacta .marca-logo {
    transform: scale(0.82);
  }
  .nav-escritorio {
    display: none;
  }
  .nav-escritorio ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-enlace {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 550;
    font-size: 0.98rem;
    color: var(--color-tinta);
    text-decoration: none;
  }
  .nav-enlace::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    background: var(--color-rojo);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-respuesta) var(--ease-salida);
  }
  .nav-enlace:hover::after,
  .nav-enlace[aria-current='location']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-enlace[aria-current='location'] {
    color: var(--color-rojo-hondo);
  }
  .cabecera-acciones {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-whatsapp {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-weight: 600;
    color: var(--color-verde-texto);
    text-decoration: none;
    border-radius: var(--r-control);
    transition: transform var(--dur-respuesta) var(--ease-salida);
  }
  .nav-whatsapp:hover {
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    /* el subrayado aparece con un fundido en lugar de dibujarse */
    .nav-enlace::after {
      transform: none;
      opacity: 0;
      transition: opacity var(--dur-respuesta) var(--ease-salida);
    }
    .nav-enlace:hover::after,
    .nav-enlace[aria-current='location']::after {
      transform: none;
      opacity: 1;
    }
    .nav-whatsapp:hover {
      transform: none;
    }
  }
  .nav-whatsapp:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cabecera-cta {
    display: none;
    min-height: 46px;
    padding-block: 0.6rem;
  }
  .menu-boton {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 48px;
    min-width: 48px;
    padding: 0 0.85rem;
    border: 0;
    border-radius: var(--r-control);
    background: var(--color-tinta);
    color: var(--color-papel);
    font: 600 0.95rem/1 var(--font-sans);
    cursor: pointer;
  }
  .menu-boton-rayas {
    position: relative;
    width: 18px;
    height: 10px;
  }
  .menu-boton-rayas span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 220ms var(--ease-salida);
  }
  .menu-boton-rayas span:first-child {
    top: 0;
  }
  .menu-boton-rayas span:last-child {
    bottom: 0;
  }
  .menu-boton[aria-expanded='true'] .menu-boton-rayas span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-boton[aria-expanded='true'] .menu-boton-rayas span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .menu-movil {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--color-papel);
    overflow-y: auto;
    z-index: 49;
  }
  .menu-movil-nav {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding-block: 1.5rem 2rem;
  }
  .menu-movil ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-linea);
  }
  .menu-movil li {
    border-bottom: 1px solid var(--color-linea);
  }
  .menu-movil-enlace {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.05rem 0;
    min-height: 56px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 2.75rem);
    line-height: 1.05;
    color: var(--color-tinta);
    text-decoration: none;
  }
  .menu-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-gris);
  }
  .menu-movil-pie {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .menu-movil-pie p {
    margin: 0.5rem 0 0;
    color: var(--color-gris);
    font-size: 0.95rem;
  }

  @media (min-width: 640px) {
    .nav-whatsapp {
      display: inline-flex;
    }
  }
  @media (min-width: 1024px) {
    .nav-escritorio {
      display: block;
    }
    .cabecera-cta {
      display: inline-flex;
    }
    .menu-boton,
    .menu-movil {
      display: none !important;
    }
  }
  @media (max-width: 1023px) {
    .marca-logo {
      height: 46px;
    }
  }
</style>

<script>
  import { animate, stagger } from 'motion';
  import { movimientoReducido, easeSalida } from '../scripts/anim';

  const cabecera = document.querySelector<HTMLElement>('[data-cabecera]')!;
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]')!;
  const texto = document.querySelector<HTMLElement>('[data-menu-texto]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  // 1. La barra se compacta al bajar
  const marcar = () => cabecera.classList.toggle('compacta', window.scrollY > 24);
  marcar();
  window.addEventListener('scroll', marcar, { passive: true });

  // 2. Marca la sección actual
  const enlaces = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav-enlace]').forEach((a) => enlaces.set(a.dataset.navEnlace!, a));
  const visibles = new Set<string>();
  const io = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((e) => (e.isIntersecting ? visibles.add(e.target.id) : visibles.delete(e.target.id)));
      enlaces.forEach((a, id) => {
        if (visibles.has(id)) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  enlaces.forEach((_, id) => {
    const s = document.getElementById(id);
    if (s) io.observe(s);
  });

  // 3. Menú del celular: transición que se puede interrumpir
  let abierto = false;
  let animacion: ReturnType<typeof animate> | null = null;

  const enfocables = () =>
    Array.from(menu.querySelectorAll<HTMLElement>('a, button')).filter((el) => el.offsetParent !== null);

  function abrir() {
    abierto = true;
    menu.hidden = false;
    boton.setAttribute('aria-expanded', 'true');
    texto.textContent = 'Cerrar';
    cabecera.classList.add('menu-abierto');
    document.body.style.overflow = 'hidden';
    animacion?.stop();
    if (!movimientoReducido()) {
      animacion = animate(menu, { clipPath: ['inset(0 0 100% 0)', 'inset(0 0 0% 0)'] }, { duration: 0.45, ease: easeSalida });
      animate(menu.querySelectorAll('[data-menu-item]'), { opacity: [0, 1], x: [-18, 0] }, { delay: stagger(0.06, { startDelay: 0.12 }), duration: 0.4, ease: easeSalida });
    } else {
      // movimiento reducido: el menú se abre con un fundido, sin cortina ni desplazamiento
      animacion = animate(menu, { opacity: [0, 1] }, { duration: 0.2 });
    }
    enfocables()[0]?.focus();
  }

  function cerrar(devolverFoco = true) {
    abierto = false;
    boton.setAttribute('aria-expanded', 'false');
    texto.textContent = 'Menú';
    cabecera.classList.remove('menu-abierto');
    document.body.style.overflow = '';
    animacion?.stop();
    const fin = () => {
      if (!abierto) menu.hidden = true;
    };
    if (movimientoReducido()) {
      animacion = animate(menu, { opacity: 0 }, { duration: 0.15 });
      animacion.then(() => {
        fin();
        menu.style.opacity = '';
      });
    } else {
      animacion = animate(menu, { clipPath: 'inset(0 0 100% 0)' }, { duration: 0.3, ease: easeSalida });
      animacion.then(fin);
    }
    if (devolverFoco) boton.focus();
  }

  boton.addEventListener('click', () => (abierto ? cerrar() : abrir()));
  menu.querySelectorAll('[data-menu-cierra]').forEach((a) => a.addEventListener('click', () => cerrar(false)));
  document.addEventListener('keydown', (e) => {
    if (!abierto) return;
    if (e.key === 'Escape') cerrar();
    if (e.key === 'Tab') {
      const lista = [boton, ...enfocables()];
      const i = lista.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) {
        e.preventDefault();
        lista[lista.length - 1].focus();
      } else if (!e.shiftKey && i === lista.length - 1) {
        e.preventDefault();
        lista[0].focus();
      }
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => {
    if (m.matches && abierto) cerrar(false);
  });
</script>
