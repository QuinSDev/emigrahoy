---
import { Picture } from 'astro:assets';
import calle from '../../assets/photos/italia-calle.jpg';
import Sello from '../Sello.astro';
import { site, cta } from '../../config/site';

const titulo = ['Emigra', 'con', 'tus', 'papeles', 'en', 'orden'];
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="wrap hero-grid">
    <div class="hero-texto">
      <h1 id="hero-titulo" class="hero-h1">
        {
          titulo.map((p, i) => (
            <>
              <span class:list={['hero-palabra', { 'hero-cursiva': i >= 4 }]} data-hero-palabra>
                <span>{p}</span>
              </span>{' '}
            </>
          ))
        }
      </h1>
      <p class="hero-lead" data-hero-aparece>
        Ciudadanía italiana, visas y viajes desde Colombia. Te acompañamos paso a paso, con sede física en Envigado.
      </p>
      <div class="hero-acciones">
        <a href={cta.href} class="btn btn-sello" data-hero-boton>
          {cta.texto}
          <svg class="flecha" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false"
            ><path d="M3 9h11M10 4.5 14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg
          >
        </a>
        <a href={site.whatsapp.href} class="btn btn-linea" target="_blank" rel="noopener" data-hero-boton>
          Escríbenos por WhatsApp
        </a>
      </div>
      <p class="hero-prueba" data-hero-aparece>
        <a href={site.resenas.href} class="enlace" target="_blank" rel="noopener"
          >Lee nuestras {site.resenas.total} reseñas en Google <span aria-hidden="true">↗</span></a
        >
        <span class="hero-prueba-sep" aria-hidden="true">·</span>
        <span>Sede en Envigado, Antioquia</span>
      </p>
    </div>

    <div class="hero-visual">
      <div class="hero-folio" data-hero-fondo aria-hidden="true">
        <span class="mrz">P&lt;COLEMIGRAHOY&lt;&lt;ENVIGADO&lt;&lt;ANTIOQUIA&lt;&lt;&lt;&lt;&lt;&lt;</span>
      </div>
      <div class="hero-foto" data-hero-foto>
        <Picture
          src={calle}
          formats={['avif', 'webp']}
          widths={[420, 640, 720]}
          sizes="(min-width: 1024px) 34vw, (min-width: 640px) 60vw, 92vw"
          alt="Calle de piedra en un pueblo de Italia, con geranios rojos en las escaleras y luz de tarde"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
          data-source="client"
          data-subject="destino"
        />
      </div>
      <Sello
        id="hero"
        anillo="EMIGRAHOY · SEDE FÍSICA · ATENCIÓN EN PERSONA · "
        centro={['ENVIGADO', 'ANTIOQUIA']}
        class="hero-sello"
        giro={-9}
        relleno
        data-hero-sello
      />

    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vh, 3rem));
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
    display: flex;
    align-items: center;
    background: var(--color-papel);
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hero-h1 {
    margin: 0;
    font-size: clamp(3.1rem, 12.5vw, 4.4rem);
    font-weight: 480;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .hero-palabra {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero-palabra > span {
    display: inline-block;
  }
  .hero-cursiva {
    font-style: italic;
    color: var(--color-verde-texto);
  }
  .hero-lead {
    margin: 1.5rem 0 0;
    max-width: 34ch;
    font-size: clamp(1.1rem, 1.3vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-tinta);
  }
  .hero-acciones {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-visual {
    position: relative;
    justify-self: stretch;
    padding: 0 0 2.5rem 0;
  }
  .hero-folio {
    position: absolute;
    inset: 1.5rem -0.75rem 0.75rem 1.75rem;
    background: var(--color-folio);
    border: 1px solid var(--color-linea);
    border-radius: var(--r-papel);
    display: flex;
    align-items: flex-end;
    padding: 0 1rem 0.85rem;
  }
  .hero-folio .mrz {
    font-size: 0.72rem;
    color: var(--color-gris);
  }
  .hero-foto {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-papel);
    width: calc(100% - 1rem);
  }
  .hero-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    display: block;
  }
  .hero-sello {
    position: absolute;
    top: -1.75rem;
    right: -0.25rem;
    width: clamp(108px, 30vw, 150px);
    filter: drop-shadow(0 10px 14px rgb(28 38 32 / 0.18));
  }
  .hero-prueba {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.75rem;
    margin: 1.25rem 0 0;
    color: var(--color-gris);
    font-size: 0.98rem;
  }
  .hero-prueba .enlace {
    color: var(--color-verde-texto);
  }
  @media (max-width: 639px) {
    .hero-prueba-sep {
      display: none;
    }
  }

  @media (min-width: 640px) {
    .hero-acciones {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .hero-foto {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
    .hero-h1 {
      font-size: clamp(4.6rem, 7.6vw, 7.4rem);
    }
    .hero-visual {
      padding: 2.5rem 0 1rem;
    }
    .hero-foto {
      aspect-ratio: 4 / 5;
      max-height: min(66svh, 620px);
      width: auto;
      margin-left: auto;
      margin-right: 1.25rem;
    }
    .hero-folio {
      inset: 0 0 3rem 3.5rem;
    }
    .hero-sello {
      top: 0.5rem;
      right: auto;
      left: -3.5rem;
      width: 156px;
    }
  }
</style>

<script>
  import { animate, stagger } from 'motion';
  import { conMovimiento, easeSalida, sellar, tiempo } from '../../scripts/anim';

  (window as unknown as { __ehListo: boolean }).__ehListo = true;

  if (conMovimiento()) {
    const q = (s: string) => document.querySelectorAll<HTMLElement>(s);
    const entrada = tiempo('--dur-entrada');
    const paso = tiempo('--paso-grupo');

    // 1. Fondo (la hoja de papel)  2. Imagen  3. Título por palabras  4. Botones  5. Sello
    animate(q('[data-hero-fondo]'), { clipPath: ['inset(0 0 100% 0)', 'inset(0 0 0% 0)'] }, { duration: 0.6, ease: easeSalida });
    animate(q('[data-hero-foto]'), { clipPath: ['inset(100% 0 0 0)', 'inset(0% 0 0 0)'] }, { duration: entrada + 0.1, delay: 0.12, ease: easeSalida });
    animate(q('[data-hero-foto] img'), { scale: [1.14, 1] }, { duration: 1.2, delay: 0.12, ease: easeSalida });
    animate(q('[data-hero-palabra] > span'), { y: ['108%', '0%'] }, { duration: 0.65, delay: stagger(paso, { startDelay: 0.25 }), ease: easeSalida });
    animate(q('.hero-lead'), { opacity: [0, 1] }, { duration: 0.5, delay: 0.75 });
    // al terminar se quita el recorte para que el foco y el realce del botón no queden cortados
    animate(q('[data-hero-boton]'), { clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'] }, { duration: 0.45, delay: stagger(paso, { startDelay: 0.95 }), ease: easeSalida }).then(() =>
      q('[data-hero-boton]').forEach((b) => (b.style.clipPath = 'none')),
    );
    animate(q('.hero-prueba'), { opacity: [0, 1] }, { duration: 0.45, delay: 1.1 });
    q('[data-hero-sello]').forEach((s) => sellar(s, 1.25));
  }
</script>
