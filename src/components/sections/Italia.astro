---
import { Picture } from 'astro:assets';
import toscana from '../../assets/photos/italia-toscana.jpg';
import { viasItalia } from '../../data/rutas';

const v0 = viasItalia[0];
---

<section id="italia" class="italia" aria-labelledby="italia-titulo">
  <div class="italia-escena" data-italia-escena>
    <div class="italia-marco" data-italia-marco>
      <Picture
        src={toscana}
        formats={['avif', 'webp']}
        widths={[800, 1280, 1920, 2400]}
        sizes="100vw"
        alt="Colinas verdes de la Toscana al amanecer, con una casa de piedra entre cipreses y niebla en el valle"
        class="italia-img"
        data-italia-img
        data-source="client"
        data-subject="destino"
      />
    </div>

    <div class="wrap italia-capa">
      <div class="italia-panel" data-italia-panel>
        <h2 id="italia-titulo">Tu ciudadanía italiana tiene tres caminos</h2>
        <p class="italia-intro">
          Revisamos tu árbol familiar y tus actas para decirte si aplicas y qué vía te conviene.
        </p>

        <div class="italia-comparador">
          <div role="tablist" aria-label="Vías para la ciudadanía italiana" class="italia-tabs" data-vias-tabs>
            {
              viasItalia.map((v, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`via-${v.id}`}
                  aria-controls="via-panel"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-via={v.id}
                  class="italia-tab"
                >
                  {v.nombre}
                </button>
              ))
            }
            <span class="italia-tab-marca" aria-hidden="true" data-vias-marca></span>
          </div>
          <div id="via-panel" role="tabpanel" aria-labelledby={`via-${v0.id}`} class="italia-via" data-vias-panel>
            <dl>
              <div>
                <dt>Dónde se hace</dt>
                <dd data-campo="donde">{v0.donde}</dd>
              </div>
              <div>
                <dt>¿Tienes que viajar?</dt>
                <dd data-campo="viajar">{v0.viajar}</dd>
              </div>
              <div>
                <dt>Qué hacemos nosotros</dt>
                <dd data-campo="nosotros">{v0.nosotros}</dd>
              </div>
            </dl>
          </div>
        </div>

        <p class="italia-nota">
          La ley italiana cambió en 2025. En la asesoría revisamos tu caso con las reglas vigentes.
        </p>
      </div>
    </div>
  </div>
  <script type="application/json" id="vias-datos" set:html={JSON.stringify(viasItalia)} />
</section>

<style>
  .italia {
    position: relative;
    background: var(--color-papel);
  }
  /* El espacio del recorrido se reserva aquí (CSS), no lo inserta el JS: así no hay saltos de diseño */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .italia {
      height: calc(max(100svh, 720px) + 110svh);
    }
  }
  .italia-escena {
    position: relative;
  }
  .italia-marco {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .italia-marco :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    display: block;
    transform-origin: 50% 62%;
  }
  .italia-capa {
    position: relative;
    margin-top: -4rem;
    padding-bottom: var(--sec-y);
  }
  .italia-panel {
    position: relative;
    background: var(--color-papel);
    border: 1px solid var(--color-linea);
    border-radius: var(--r-papel);
    padding: 1.75rem 1.25rem;
    box-shadow: 0 30px 60px -40px rgb(22 48 32 / 0.55);
  }
  .italia-panel h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    max-width: 13ch;
  }
  .italia-intro {
    margin: 1rem 0 0;
    max-width: 40ch;
    color: var(--color-gris);
  }
  .italia-comparador {
    margin-top: 1.75rem;
  }
  .italia-tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--color-linea);
  }
  .italia-tab {
    min-height: 48px;
    padding: 0.5rem 0.25rem;
    border: 0;
    background: none;
    font: 600 0.98rem/1.2 var(--font-sans);
    color: var(--color-gris);
    cursor: pointer;
    transition: color var(--dur-respuesta) var(--ease-salida);
  }
  .italia-tab:hover {
    color: var(--color-tinta);
  }
  .italia-tab[aria-selected='true'] {
    color: var(--color-tinta);
  }
  .italia-tab-marca {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: calc(100% / 3);
    height: 3px;
    background: var(--color-rojo);
    transition: transform 320ms var(--ease-salida);
  }
  @media (prefers-reduced-motion: reduce) {
    /* la marca salta a la pestaña elegida; el fundido de color de la pestaña lleva el cambio */
    .italia-tab-marca {
      transition: none;
    }
  }
  .italia-via dl {
    margin: 0;
    display: grid;
  }
  .italia-via dl > div {
    display: grid;
    gap: 0.2rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--color-linea);
  }
  .italia-via dt {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-gris);
  }
  .italia-via dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .italia-nota {
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
    color: var(--color-gris);
    padding-left: 0.9rem;
    border-left: 3px solid var(--color-verde);
  }

  @media (min-width: 640px) {
    .italia-panel {
      padding: 2.25rem 2.25rem 2rem;
    }
    .italia-via dl > div {
      grid-template-columns: 11rem 1fr;
      gap: 1rem;
      align-items: baseline;
    }
  }

  @media (min-width: 1024px) {
    .italia-escena {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 720px;
      overflow: hidden;
    }
    .italia-marco {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
    .italia-capa {
      height: 100%;
      margin-top: 0;
      padding-top: calc(var(--header-h) + 1.5rem);
      padding-bottom: 2rem;
      display: flex;
      align-items: center;
    }
    .italia-panel {
      width: min(560px, 44%);
    }
  }
</style>

<script>
  import { animate } from 'motion';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { easeSalida, movimientoReducido, tiempo } from '../../scripts/anim';

  // ---------- Comparador de vías (interacción 2) ----------
  type Via = { id: string; nombre: string; donde: string; viajar: string; nosotros: string };
  const vias = JSON.parse(document.getElementById('vias-datos')!.textContent!) as Via[];
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-via]'));
  const panel = document.querySelector<HTMLElement>('[data-vias-panel]')!;
  const marca = document.querySelector<HTMLElement>('[data-vias-marca]')!;
  const campos = panel.querySelectorAll<HTMLElement>('[data-campo]');

  function elegir(i: number, foco = false) {
    const via = vias[i];
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(i === j));
      t.tabIndex = i === j ? 0 : -1;
    });
    if (foco) tabs[i].focus();
    panel.setAttribute('aria-labelledby', tabs[i].id);
    marca.style.transform = `translateX(${i * 100}%)`;
    const aplicar = () => campos.forEach((c) => (c.textContent = via[c.dataset.campo as keyof Via]));
    if (movimientoReducido()) return aplicar();
    animate(campos, { opacity: 0 }, { duration: tiempo('--dur-respuesta') * 0.5 }).then(() => {
      aplicar();
      animate(campos, { opacity: [0, 1], clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'] }, { duration: 0.4, ease: easeSalida });
    });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => elegir(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        elegir((i + 1) % tabs.length, true);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        elegir((i - 1 + tabs.length) % tabs.length, true);
      }
    });
  });

  // ---------- Momento principal: la ventana de foto carnet se abre a la Toscana ----------
  gsap.registerPlugin(ScrollTrigger);
  const escena = document.querySelector<HTMLElement>('[data-italia-escena]')!;
  const marco = document.querySelector<HTMLElement>('[data-italia-marco]')!;
  const img = marco.querySelector<HTMLElement>('img')!;

  const mm = gsap.matchMedia();
  // will-change solo mientras la escena se recorre; en reposo no reserva capas
  const preparar = (activo: boolean, conImagen = false) => {
    marco.style.willChange = activo ? 'clip-path' : '';
    if (conImagen) img.style.willChange = activo ? 'transform' : '';
  };

  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    // la ventana (proporción 35 x 45 mm) a la derecha del texto
    const ventana = () => {
      const w = escena.clientWidth;
      const h = escena.clientHeight;
      const vw = Math.min(w * 0.22, 330);
      const vh = (vw * 45) / 35;
      const cx = w * 0.73;
      const cy = h / 2 + 30;
      return { t: cy - vh / 2, r: w - (cx + vw / 2), b: h - (cy + vh / 2), l: cx - vw / 2 };
    };
    // la escena es sticky (CSS); GSAP solo liga la apertura al recorrido de la sección
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: escena.parentElement,
        start: 'top top',
        end: () => '+=' + Math.round(window.innerHeight * 1.1 * 0.82),
        scrub: 0.6,
        invalidateOnRefresh: true,
        onToggle: (self) => preparar(self.isActive, true),
      },
    });
    tl.fromTo(
      marco,
      {
        clipPath: () => {
          const v = ventana();
          return `inset(${v.t}px ${v.r}px ${v.b}px ${v.l}px round 3px)`;
        },
      },
      { clipPath: 'inset(0px 0px 0px 0px round 0px)', ease: 'power1.inOut', duration: 1 },
      0,
    ).fromTo(img, { scale: 1.45 }, { scale: 1, ease: 'power1.inOut', duration: 1 }, 0);
    return () => {
      preparar(false, true);
      marco.style.clipPath = '';
      img.style.transform = '';
    };
  });

  mm.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
    gsap.fromTo(
      marco,
      { clipPath: 'inset(10% 9% 10% 9% round 3px)' },
      {
        clipPath: 'inset(0% 0% 0% 0% round 0px)',
        ease: 'none',
        scrollTrigger: {
          trigger: marco,
          start: 'top 95%',
          end: 'center 55%',
          scrub: 0.5,
          onToggle: (self) => preparar(self.isActive),
        },
      },
    );
    return () => {
      preparar(false);
      marco.style.clipPath = '';
    };
  });
</script>
