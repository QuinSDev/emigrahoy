---
import { Picture } from 'astro:assets';
import pasaporte from '../../assets/photos/pasaporte-sellos.jpg';
import Sello from '../Sello.astro';

const pasos = [
  {
    titulo: 'Asesoría',
    nosotros: 'Revisamos tu caso y te decimos qué vía o qué visa aplica.',
    tu: 'Vienes a la sede en Envigado o te conectas por videollamada.',
    sello: ['CASO', 'REVISADO'],
  },
  {
    titulo: 'Documentos',
    nosotros: 'Te damos la lista exacta y revisamos cada papel antes de usarlo.',
    tu: 'Reúnes lo que tengas. Te decimos qué falta y cómo conseguirlo.',
    sello: ['CARPETA', 'COMPLETA'],
  },
  {
    titulo: 'Solicitud',
    nosotros: 'Preparamos la solicitud contigo y la presentamos donde corresponde.',
    tu: 'Firmas y asistes a las citas que pida tu trámite.',
    sello: ['SOLICITUD', 'PRESENTADA'],
  },
  {
    titulo: 'Seguimiento',
    nosotros: 'Te contamos cada avance hasta tener la respuesta final.',
    tu: 'Preguntas cuando quieras, por WhatsApp o en la sede.',
    sello: ['CASO', 'EN CURSO'],
  },
];
---

<section id="proceso" class="proceso" aria-labelledby="proceso-titulo">
  <div class="proceso-hoja" data-proceso-hoja>
    <div class="wrap proceso-cabeza">
      <h2 id="proceso-titulo">Cuatro pasos y siempre sabes en cuál vas</h2>
      <div class="proceso-lado">
        <p>Tú traes lo que tengas. Del resto nos encargamos contigo, paso a paso.</p>
        <div class="proceso-controles">
          <button type="button" class="proceso-flecha" data-proceso-prev aria-label="Ver el paso anterior">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"
              ><path d="M16 10H4M8.5 5.5 4 10l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg
            >
          </button>
          <button type="button" class="proceso-flecha" data-proceso-next aria-label="Ver el paso siguiente">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"
              ><path d="M4 10h12M11.5 5.5 16 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg
            >
          </button>
          <p class="proceso-estado" data-proceso-estado>Desliza para ver los 4 pasos</p>
        </div>
        <p class="visually-hidden" aria-live="polite" data-proceso-anuncio></p>
      </div>
    </div>

    <div
      class="proceso-pista"
      data-proceso-pista
      tabindex="0"
      role="region"
      aria-label="Pasos del proceso. Usa las flechas del teclado para moverte."
    >
      <ol class="proceso-lista">
        <li class="pagina pagina-foto" data-pagina>
          <Picture
            src={pasaporte}
            formats={['avif', 'webp']}
            widths={[560, 900, 1300]}
            sizes="(min-width: 1024px) 46vw, 88vw"
            alt="Pasaporte abierto en dos páginas llenas de sellos de entrada y salida de varios países"
            data-source="stand-in"
            data-subject="proceso"
          />
        </li>
        {
          pasos.map((p, i) => (
            <li class="pagina" data-pagina data-paso={i + 1}>
              <div class="pagina-cabeza">
                <span>Folio {String(i + 1).padStart(2, '0')}</span>
                <span aria-hidden="true">EmigraHoy</span>
              </div>
              <h3>
                <span class="visually-hidden">Paso {i + 1}: </span>
                {p.titulo}
              </h3>
              <dl class="pagina-dl">
                <div>
                  <dt>Nosotros</dt>
                  <dd>{p.nosotros}</dd>
                </div>
                <div>
                  <dt>Tú</dt>
                  <dd>{p.tu}</dd>
                </div>
              </dl>
              <Sello
                id={`paso-${i + 1}`}
                anillo={`EMIGRAHOY · PASO ${i + 1} DE 4 · ENVIGADO · `}
                centro={p.sello}
                class="pagina-sello"
                giro={i % 2 ? 9 : -11}
                data-pagina-sello
              />
              <p class="pagina-mrz mrz" aria-hidden="true">
                {`P<COL<PASO<${i + 1}<<${p.titulo.toUpperCase()}<<<<<<<<<<<<<<<<<<<<`}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .proceso {
    background: var(--color-papel);
  }
  .proceso-hoja {
    background: var(--color-folio);
    padding-block: var(--sec-y);
    min-height: 100svh;
  }
  .proceso-cabeza {
    display: grid;
    gap: 1.25rem;
  }
  .proceso-cabeza h2 {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 4.25rem);
    max-width: 14ch;
  }
  .proceso-lado p {
    margin: 0;
    max-width: 38ch;
    font-size: 1.125rem;
    color: var(--color-gris);
  }
  .proceso-controles {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .proceso-controles .proceso-estado {
    margin-left: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-tinta);
    font-weight: 600;
  }
  .proceso-flecha {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--color-tinta);
    border-radius: var(--r-control);
    background: transparent;
    color: var(--color-tinta);
    cursor: pointer;
    transition:
      transform var(--dur-respuesta) var(--ease-salida),
      background-color var(--dur-respuesta) var(--ease-salida),
      color var(--dur-respuesta) var(--ease-salida);
  }
  .proceso-flecha:hover {
    background: var(--color-tinta);
    color: var(--color-papel);
  }
  .proceso-flecha:active {
    transform: scale(0.95);
  }
  @media (prefers-reduced-motion: reduce) {
    .proceso-flecha:active {
      transform: none;
    }
  }
  .proceso-flecha:disabled {
    opacity: 0.35;
    cursor: default;
    background: transparent;
    color: var(--color-tinta);
  }

  .proceso-pista {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--color-linea) transparent;
    padding-inline: max(var(--gutter), calc((100% - var(--wrap)) / 2));
    scroll-padding-inline: max(var(--gutter), calc((100% - var(--wrap)) / 2));
    padding-bottom: 1.25rem;
    cursor: grab;
  }
  .proceso-pista.arrastrando {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .proceso-pista.arrastrando * {
    user-select: none;
  }
  .proceso-lista {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
  }
  .pagina {
    position: relative;
    flex: none;
    width: min(84vw, 420px);
    min-height: 470px;
    padding: 1.5rem 1.5rem 3.5rem;
    background: var(--color-papel);
    border: 1px solid var(--color-linea);
    border-left-width: 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .pagina:nth-child(even) {
    box-shadow: inset 14px 0 18px -16px rgb(28 38 32 / 0.35);
  }
  .pagina-foto {
    width: min(88vw, 640px);
    padding: 0;
    border-left-width: 1px;
  }
  .pagina-foto :global(picture) {
    display: block;
    height: 100%;
  }
  .pagina-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pagina-cabeza {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-gris);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-linea);
  }
  .pagina h3 {
    margin: 1.5rem 0 0;
    font-size: clamp(2.2rem, 3.4vw, 3rem);
  }
  .pagina-dl {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .pagina-dl div {
    display: grid;
    gap: 0.15rem;
  }
  .pagina-dl dt {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-verde-texto);
  }
  .pagina-dl dd {
    margin: 0;
    line-height: 1.5;
  }
  .pagina-sello {
    position: absolute;
    right: 1.25rem;
    bottom: 2.6rem;
    width: 118px;
    mix-blend-mode: multiply;
    opacity: 0.92;
  }
  .pagina-mrz {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 0.9rem;
    margin: 0;
    font-size: 0.7rem;
    color: var(--color-gris);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .proceso-cabeza h2 {
      max-width: none;
      font-size: clamp(3.5rem, 6.4vw, 6rem);
    }
    .proceso-lado {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-linea);
    }
    .proceso-controles {
      margin-top: 0;
    }
    .pagina {
      width: clamp(340px, 27vw, 420px);
      min-height: min(56svh, 520px);
    }
    .pagina-foto {
      width: clamp(520px, 42vw, 660px);
    }
  }
</style>

<script>
  import { animate, inView, stagger } from 'motion';
  import { conMovimiento, easeSalida, movimientoReducido, sellar } from '../../scripts/anim';

  const seccion = document.getElementById('proceso')!;
  const hoja = seccion.querySelector<HTMLElement>('[data-proceso-hoja]')!;
  const pista = seccion.querySelector<HTMLElement>('[data-proceso-pista]')!;
  const paginas = Array.from(seccion.querySelectorAll<HTMLElement>('[data-pagina]'));
  const pasos = paginas.filter((p) => p.dataset.paso);
  const prev = seccion.querySelector<HTMLButtonElement>('[data-proceso-prev]')!;
  const next = seccion.querySelector<HTMLButtonElement>('[data-proceso-next]')!;
  const estado = seccion.querySelector<HTMLElement>('[data-proceso-estado]')!;
  const animar = conMovimiento();

  // Sellos: cada página recibe su sello cuando queda a la vista dentro del recorrido
  const sellos = new Map<Element, SVGElement>();
  pasos.forEach((p) => sellos.set(p, p.querySelector<SVGElement>('[data-pagina-sello]')!));
  if (animar) sellos.forEach((s) => (s.style.opacity = '0'));

  const vistos = new Map<Element, number>();
  // el sello solo cae cuando la persona está mirando la sección (si no, se perdería el golpe)
  let mirando = false;
  const sellarPagina = (p: Element, retraso = 0.15) => {
    if (p.classList.contains('sellado')) return;
    p.classList.add('sellado');
    if (animar) sellar(sellos.get(p)!, retraso);
  };
  inView(
    pista,
    () => {
      mirando = true;
      let n = 0;
      vistos.forEach((r, p) => r >= 0.65 && sellarPagina(p, 0.7 + 0.18 * n++));
      return () => (mirando = false);
    },
    { amount: 0.5 },
  );
  const io = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((e) => {
        vistos.set(e.target, e.intersectionRatio);
        if (mirando && e.intersectionRatio >= 0.65) sellarPagina(e.target);
      });
      // paso más visible
      let mejor = 0;
      let ratio = 0;
      pasos.forEach((p, i) => {
        const r = vistos.get(p) ?? 0;
        if (r > ratio + 0.01) {
          ratio = r;
          mejor = i + 1;
        }
      });
      if (mejor) estado.textContent = `Paso ${mejor} de ${pasos.length}: ${pasos[mejor - 1].querySelector('h3')!.textContent!.replace(/Paso \d+:\s*/, '').trim()}`;
      actualizarFlechas();
    },
    { root: pista, threshold: [0, 0.35, 0.65, 1] },
  );
  pasos.forEach((p) => io.observe(p));

  // Flechas y teclado. Solo se anuncia el paso cuando la persona lo pidió con un botón o una flecha,
  // y una vez que la pista se detuvo (no en cada cambio de intersección al deslizar).
  const anuncio = seccion.querySelector<HTMLElement>('[data-proceso-anuncio]')!;
  let anunciarPendiente = false;
  let relojAnuncio = 0;
  const anunciar = () => {
    if (!anunciarPendiente) return;
    anunciarPendiente = false;
    window.clearTimeout(relojAnuncio);
    anuncio.textContent = estado.textContent;
  };
  pista.addEventListener('scrollend', anunciar);
  const avance = () => (pasos[0]?.getBoundingClientRect().width ?? 400);
  const mover = (dir: number) => {
    anunciarPendiente = true;
    window.clearTimeout(relojAnuncio);
    relojAnuncio = window.setTimeout(anunciar, 800); // por si el navegador no emite scrollend
    pista.scrollBy({ left: dir * avance(), behavior: movimientoReducido() ? 'auto' : 'smooth' });
  };
  function actualizarFlechas() {
    prev.disabled = pista.scrollLeft <= 4;
    next.disabled = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 4;
  }
  prev.addEventListener('click', () => mover(-1));
  next.addEventListener('click', () => mover(1));
  pista.addEventListener('scroll', actualizarFlechas, { passive: true });
  pista.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      mover(1);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      mover(-1);
    }
  });
  actualizarFlechas();

  // Arrastre con mouse (el dedo y el trackpad ya desplazan de forma nativa)
  let x0 = 0;
  let s0 = 0;
  let arrastrando = false;
  pista.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse' || e.button !== 0) return;
    arrastrando = true;
    x0 = e.clientX;
    s0 = pista.scrollLeft;
    pista.classList.add('arrastrando');
    pista.setPointerCapture(e.pointerId);
  });
  pista.addEventListener('pointermove', (e) => {
    if (arrastrando) pista.scrollLeft = s0 - (e.clientX - x0);
  });
  const soltar = () => {
    if (!arrastrando) return;
    arrastrando = false;
    pista.classList.remove('arrastrando');
  };
  pista.addEventListener('pointerup', soltar);
  pista.addEventListener('pointercancel', soltar);
  pista.addEventListener('lostpointercapture', soltar);
  window.addEventListener('blur', soltar);

  // Entrada: una máscara descubre la hoja y las páginas llegan de la derecha
  if (animar) {
    hoja.style.clipPath = 'inset(5% 4% 5% 4% round 6px)';
    paginas.forEach((p) => (p.style.opacity = '0'));
    inView(
      seccion,
      () => {
        animate(hoja, { clipPath: ['inset(5% 4% 5% 4% round 6px)', 'inset(0% 0% 0% 0% round 0px)'] }, { duration: 0.8, ease: easeSalida }).then(
          () => (hoja.style.clipPath = 'none'),
        );
        animate(paginas, { opacity: [0, 1], x: [80, 0] }, { delay: stagger(0.09, { startDelay: 0.3 }), duration: 0.7, ease: easeSalida });
      },
      { amount: 0.15 },
    );
  }
</script>
