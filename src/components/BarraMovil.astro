---
import { site, cta } from '../config/site';
---

<div class="barra" data-barra role="region" aria-label="Contacto rápido">
  <a href={cta.href} class="btn btn-sello barra-cta" data-barra-cta>{cta.texto}</a>
  <a href={site.whatsapp.href} class="barra-wa" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"
      ><path
        fill="currentColor"
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91A9.85 9.85 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.16.04-.3-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48a.92.92 0 0 0-.67.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.16 1.75 2.67 4.24 3.75 1.58.68 2.2.74 2.99.62.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"
      ></path></svg
    >
  </a>
</div>

<style>
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
    background: var(--color-papel);
    box-shadow: 0 -1px 0 var(--color-linea);
    transform: translateY(110%);
    transition: transform 300ms var(--ease-salida);
  }
  .barra.visible {
    transform: translateY(0);
  }
  .barra-cta {
    flex: 1;
  }
  .barra-wa {
    display: grid;
    place-items: center;
    width: 52px;
    min-height: 52px;
    border-radius: var(--r-control);
    background: var(--color-verde-texto);
    color: var(--color-blanco);
    flex: none;
    transition: transform var(--dur-respuesta) var(--ease-salida);
  }
  .barra-wa:active {
    transform: scale(0.96);
  }
  @media (prefers-reduced-motion: reduce) {
    /* la barra llega con un fundido, sin subir desde el borde */
    .barra {
      transform: none;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 250ms var(--ease-salida),
        visibility 0s linear 250ms;
    }
    .barra.visible {
      opacity: 1;
      visibility: visible;
      transition: opacity 250ms var(--ease-salida);
    }
    .barra-wa:active {
      transform: none;
    }
  }
  @media (min-width: 1024px) {
    .barra {
      display: none;
    }
  }
</style>

<script>
  // Aparece cuando el botón de la entrada ya no se ve y se esconde al llegar al formulario.
  const barra = document.querySelector<HTMLElement>('[data-barra]')!;
  const hero = document.getElementById('inicio');
  const agenda = document.getElementById('agenda');
  let heroVisible = true;
  let agendaVisible = false;
  const pintar = () => {
    const v = !heroVisible && !agendaVisible;
    barra.classList.toggle('visible', v);
    barra.inert = !v;
  };
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (e.target === hero) heroVisible = e.isIntersecting;
      if (e.target === agenda) agendaVisible = e.isIntersecting;
    });
    pintar();
  }, { threshold: 0.05 });
  if (hero) io.observe(hero);
  if (agenda) io.observe(agenda);
  pintar();
</script>
